/* Application stylesheet. Dollar-prefixed tokens are filled from ThemeTokens. */
QWidget { background-color: $background; color: $text; }
QMainWindow, QDialog { background-color: $background; }
QMenuBar, QMenu, QStatusBar, QDockWidget { background-color: $surface; }
QMenu { border: 1px solid $border; }
QMenu::item:selected, QListView::item:selected {
    background-color: $accent; color: $accent_text;
}
QDockWidget::title { padding: 6px; border-bottom: 1px solid $border; }
QListView, QLineEdit, QListWidget {
    background-color: $surface; border: 1px solid $border; border-radius: 4px; padding: 4px;
}
QLineEdit:focus, QListView:focus, QListWidget:focus { border: 2px solid $accent; }
QPushButton {
    background-color: $surface; border: 1px solid $border; border-radius: 4px; padding: 6px 14px;
}
QPushButton:hover { border-color: $accent; }
QPushButton:focus { border: 2px solid $accent; }
QPushButton:disabled { color: $text_muted; }
QProgressBar { border: 1px solid $border; border-radius: 4px; text-align: center; }
QProgressBar::chunk { background-color: $accent; }
QLabel[role="muted"] { color: $text_muted; }
QLabel[role="alert"] { color: $accent; font-weight: bold; }
/* Data views, inputs and tabs (control center and later pages). */
QTreeWidget, QTableWidget, QTableView, QTreeView, QTextBrowser, QPlainTextEdit, QComboBox {
    background-color: $surface; border: 1px solid $border; border-radius: 4px;
}
QTreeWidget:focus, QTableWidget:focus, QTextBrowser:focus, QPlainTextEdit:focus, QComboBox:focus {
    border: 2px solid $accent;
}
QComboBox { padding: 4px 8px; }
QComboBox QAbstractItemView { background-color: $surface; border: 1px solid $border; }
QTreeWidget::item, QTableWidget::item { padding: 1px 4px; }
QTreeWidget::item:selected, QTableWidget::item:selected, QListWidget::item:selected {
    background-color: $accent; color: $accent_text;
}
QTableWidget { gridline-color: $border; alternate-background-color: $surface_alt; }
QHeaderView::section {
    background-color: $surface_alt; color: $text_muted; border: none;
    border-bottom: 1px solid $border; padding: 4px 6px; font-weight: 600;
}
QTabWidget::pane { border: 1px solid $border; border-radius: 4px; top: -1px; }
QTabBar::tab {
    background-color: $background; color: $text_muted; padding: 5px 12px;
    border: 1px solid $border; border-bottom: none; margin-right: 2px;
    border-top-left-radius: 4px; border-top-right-radius: 4px;
}
QTabBar::tab:selected { background-color: $surface; color: $text; }
QTabBar::tab:focus { color: $accent; }
QSplitter::handle { background-color: $border; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }
QPushButton[role="primary"] {
    background-color: $accent; color: $accent_text; border-color: $accent; font-weight: 600;
}
QPushButton[role="primary"]:disabled { background-color: $surface; color: $text_muted; }
QLabel[role="title"] { font-size: 15pt; font-weight: 600; }
QLabel[role="heading"] { font-weight: 600; padding-top: 4px; }
QLabel[role="note"] {
    background-color: $surface; border: 1px solid $border; border-left: 3px solid $warning;
    border-radius: 4px; padding: 6px 10px;
}
QLabel[role="empty"] { color: $text_muted; padding: 12px; }
QLabel[role="preview"] { background-color: $surface; border: 1px solid $border; border-radius: 4px; }
QLabel[status="ok"], QLabel[status="warn"], QLabel[status="error"], QLabel[status="info"],
QLabel[status="neutral"] { border: 1px solid $border; border-radius: 3px; padding: 1px 6px; }
QLabel[status="ok"] { color: $success; border-color: $success; }
QLabel[status="warn"] { color: $warning; border-color: $warning; }
QLabel[status="error"] { color: $danger; border-color: $danger; }
QLabel[status="info"] { color: $accent; border-color: $accent; }
QLabel[status="neutral"] { color: $text_muted; }
QLabel[role="dropzone"] {
    background-color: $surface; color: $text_muted; border: 2px dashed $border;
    border-radius: 8px; padding: 16px; font-weight: 600;
}
QPushButton[role="step"] { border-radius: 14px; padding: 4px 14px; }
QPushButton[role="step"]:checked { background-color: $accent; color: $accent_text; border-color: $accent; }
